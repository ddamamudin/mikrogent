generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  password      String
  brand         String?     @unique
  alamat        String?
  noWa          String?
  emailVerified Boolean     @default(false)
  validated     Boolean     @default(false)
  status        UserStatus  @default(ACTIVE)
  dailyChatLimit Int?
  role          Role        @default(USER)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  emailTokens        EmailToken[]
  mikrotikCredential MikrotikCredential?
  agentMemory        AgentMemory?
  agentDailyCount    AgentDailyCount?
  agentChatSession   AgentChatSession?
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id                String  @id @default("singleton")
  adminSetupEnabled Boolean @default(true)
  showBrandField    Boolean @default(true)
  claudeApiKey      String?
  openaiApiKey      String?
  llmProvider       String  @default("anthropic")
  anthropicModel    String  @default("claude-sonnet-4-6")
  openaiModel       String  @default("gpt-4o")
  agentPersona      String?
  agentKnowledge    String?
  dailyChatLimit    Int     @default(50)
}

model MikrotikCredential {
  id        String   @id @default(cuid())
  userId    String   @unique
  host      String
  port      Int      @default(22)
  sshUser   String
  sshPass   String
  connected Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String   @unique
  content   String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentChatSession {
  id          String   @id @default(cuid())
  userId      String   @unique
  messages    Json
  apiMessages Json
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentDailyCount {
  id     String @id @default(cuid())
  userId String @unique
  count  Int    @default(0)
  date   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}
