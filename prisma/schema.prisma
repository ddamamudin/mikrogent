generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  password      String
  brand         String?     @unique
  alamat        String?
  noWa          String?
  emailVerified Boolean     @default(false)
  validated     Boolean     @default(false)
  status        UserStatus  @default(ACTIVE)
  dailyChatLimit Int?
  dailyVoiceSeconds Int?
  maxRouters    Int         @default(1)
  role          Role        @default(USER)
  adminLevel    AdminLevel?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  emailTokens         EmailToken[]
  mikrotikCredentials MikrotikCredential[]
  agentDailyCount     AgentDailyCount?
  agentChatSession    AgentChatSession?
  notifications       Notification[]
  feedbacks           Feedback[]
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id                  String  @id @default("singleton")
  adminSetupEnabled   Boolean @default(true)
  registrationEnabled Boolean @default(true)
  showBrandField      Boolean @default(true)
  claudeApiKey        String?
  openaiApiKey        String?
  llmProvider         String  @default("openai")
  anthropicModel      String  @default("claude-sonnet-4-6")
  openaiModel         String  @default("gpt-4o")
  openaiRealtimeModel String  @default("gpt-realtime")
  openaiVoice         String  @default("marin")
  agentPersona        String?
  agentKnowledge      String?
  dailyChatLimit      Int     @default(50)
  voiceCallEnabled    Boolean @default(false)
  voiceDailySeconds   Int     @default(180)
  defaultMaxRouters   Int     @default(1)
}

model MikrotikCredential {
  id        String   @id @default(cuid())
  userId    String
  name      String
  host      String
  port      Int      @default(22)
  sshUser   String
  sshPass   String
  connected Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentMemory       AgentMemory?
  activeInSessions  AgentChatSession[] @relation("ActiveCredential")

  @@unique([userId, name])
  @@index([userId])
}

model AgentMemory {
  id           String             @id @default(cuid())
  credentialId String             @unique
  content      String
  updatedAt    DateTime           @updatedAt
  credential   MikrotikCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

model AgentChatSession {
  id                 String              @id @default(cuid())
  userId             String              @unique
  activeCredentialId String?
  messages           Json
  apiMessages        Json
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCredential   MikrotikCredential? @relation("ActiveCredential", fields: [activeCredentialId], references: [id], onDelete: SetNull)
}

model AgentDailyCount {
  id           String @id @default(cuid())
  userId       String @unique
  count        Int    @default(0)
  voiceSeconds Int    @default(0)
  date         String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  USER
  ADMIN
}

enum AdminLevel {
  SUPER
  VALIDATOR
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

// Audit log SSH command yang dieksekusi agent ke router user.
// Untuk forensik: siapa eksekusi command apa di router mana, sukses/gagal, durasi.
// Retention policy: cleanup baris > 90 hari via cron eksternal (belum di-setup).
model AgentSshLog {
  id           String   @id @default(cuid())
  userId       String
  credentialId String?  // null kalau credential udah dihapus (onDelete: SetNull)
  routerName   String   // disimpan denormalized supaya tetap ada kalau credential dihapus
  routerHost   String
  command      String
  ok           Boolean
  errorMsg     String?  // diisi kalau ok=false
  durationMs   Int
  source       String   // "execute_mikrotik_command" | "execute_on_routers"
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([credentialId])
  @@index([createdAt])
}

// Rate limit bucket per (action, ip). Atomic INSERT ... ON CONFLICT untuk race-safe counter.
// Persisten lewat restart PM2 / crash. Bucket expired di-reuse otomatis saat resetAt < NOW().
model RateLimitBucket {
  id        String   @id @default(cuid())
  action    String   // mis. "login", "register", "forgot"
  ip        String
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@unique([action, ip])
  @@index([resetAt])
}

// Notif per-recipient. Untuk event admin-wide (user_registered, dll) di-fan-out:
// 1 row per admin yang aktif (jadi read state independen per admin).
// Untuk event user-personal (feedback_replied) di-target ke userId-nya langsung.
model Notification {
  id        String    @id @default(cuid())
  userId    String    // recipient (admin id atau user id)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // "user_registered" | "user_email_verified" | "feedback_received" | "feedback_replied" | "feedback_resolved"
  title     String
  body      String?
  link      String?   // URL untuk navigasi saat di-klik
  meta      Json?     // konteks tambahan (tenantId, feedbackId, dll)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Feedback thread = parent record. Status OPEN/RESOLVED. messages = isi thread-nya.
model Feedback {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String    @default("OPEN")  // OPEN | RESOLVED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  FeedbackMessage[]

  @@index([userId])
  @@index([status, updatedAt])
}

// Pesan dalam thread feedback. fromRole bedain user vs admin sender.
// readByUser / readByAdmin track unread counter per-side.
model FeedbackMessage {
  id          String   @id @default(cuid())
  feedbackId  String
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  fromRole    String   // "USER" | "ADMIN"
  fromId      String   // userId atau adminId pengirim
  fromName    String   // snapshot nama (gak ke-update kalau user rename)
  body        String
  readByUser  Boolean  @default(false)
  readByAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([feedbackId, createdAt])
}
